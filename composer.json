{
    "name": "osawereao/adldap",
    "type": "library",
    "description": "A PHP LDAP Library for Active Directory Manipulation (PHP 8.2+)",
    "keywords": [
        "active directory",
        "ldap",
        "windows",
        "adldap",
        "authentication"
    ],
    "homepage": "https://osawere.com",
    "license": "LGPL-2.1",
    "support": {
        "issues": "https://github.com/osawereao/adldap/issues",
        "source": "https://github.com/osawereao/adldap"
    },
    "authors": [
        {
            "name": "Anthony Osawere",
            "email": "anthony@osawere.com",
            "homepage": "https://osawere.com",
            "role": "Maintainer"
        },
        {
            "name": "Richard Hyland",
            "email": "adldap@richardhyland.com",
            "role": "Original Developer"
        },
        {
            "name": "Scott Barnett",
            "email": "scott@wiggumworld.com",
            "role": "Developer"
        },
        {
            "name": "Steve Bauman",
            "email": "steven_bauman@outlook.com",
            "role": "Developer"
        }
    ],
    "require": {
        "php": ">=8.2",
        "ext-ldap": "*"
    },
    "require-dev": {
        "pestphp/pest": "^2.0 || ^3.0",
        "mockery/mockery": "^1.6"
    },
    "archive": {
        "exclude": ["/examples", "/tests"]
    },
    "autoload": {
        "psr-4": {
            "Adldap\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Adldap\\Tests\\": "tests/"
        }
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
